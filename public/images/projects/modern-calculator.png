@charset "utf-8";

:root { --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); -=
-card-bg: rgba(30, 41, 59, 0.96); --display-bg: #0f172a; --text-main: #f8fa=
fc; --text-muted: #94a3b8; --num-bg: #334155; --num-hover: #475569; --sci-b=
g: #1e293b; --sci-border: rgba(148, 163, 184, 0.25); --sci-hover: #334155; =
--fn-bg: #64748b; --fn-hover: #94a3b8; --op-bg: #f59e0b; --op-hover: #d9770=
6; --shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.55); }

body.light-theme { --bg-gradient: linear-gradient(135deg, #e2e8f0 0%, #f8fa=
fc 100%); --card-bg: rgba(255, 255, 255, 0.97); --display-bg: #f1f5f9; --te=
xt-main: #0f172a; --text-muted: #64748b; --num-bg: #e2e8f0; --num-hover: #c=
bd5e1; --sci-bg: #f8fafc; --sci-border: rgba(15, 23, 42, 0.16); --sci-hover=
: #e2e8f0; --fn-bg: #cbd5e1; --fn-hover: #94a3b8; --op-bg: #ea580c; --op-ho=
ver: #c2410c; --shadow: 0 18px 36px -14px rgba(15, 23, 42, 0.18); }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; f=
ont-family: "Segoe UI", system-ui, -apple-system, sans-serif; }

html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

body { min-height: 100vh; overflow-y: auto; display: flex; justify-content:=
 center; align-items: flex-start; background: var(--bg-gradient); color: va=
r(--text-main); padding: 12px 10px 24px; transition: background 0.3s, color=
 0.3s; }

.app-wrapper { width: 100%; max-width: 450px; min-width: 0px; display: flex=
; justify-content: center; align-items: flex-start; margin: auto 0px; }

.calculator { width: 100%; max-width: 430px; min-width: 0px; background: va=
r(--card-bg); border-radius: 22px; padding: 11px 13px; box-shadow: var(--sh=
adow); border: 1px solid rgba(255, 255, 255, 0.08); }

.calc-header { display: flex; justify-content: space-between; align-items: =
center; margin-bottom: 6px; }

.header-left { display: flex; align-items: center; gap: 8px; }

.brand-badge { font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px;=
 color: var(--op-bg); }

.mem-badge { font-size: 0.68rem; font-weight: 700; background: var(--op-bg)=
; color: rgb(255, 255, 255); padding: 2px 6px; border-radius: 6px; }

.header-actions { display: flex; align-items: center; gap: 5px; }

.mode-btn { background: var(--sci-bg); color: var(--text-main); border: 1px=
 solid var(--sci-border); border-radius: 999px; padding: 2px 8px; font-size=
