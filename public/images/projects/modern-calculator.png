                    <button type=3D"button" class=3D"btn btn-value" data-va=
lue=3D"^" title=3D"Power">x=CA=B8</button>

                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"sin">sin</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"cos">cos</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"tan">tan</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"asin">sin=E2=81=BB=C2=B9</button>
