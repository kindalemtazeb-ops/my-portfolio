                    <button type=3D"button" class=3D"btn btn-value" data-va=
lue=3D")">)</button>

                    <button type=3D"button" class=3D"btn btn-num" data-valu=
e=3D"1">1</button>
                    <button type=3D"button" class=3D"btn btn-num" data-valu=
e=3D"2">2</button>
                    <button type=3D"button" class=3D"btn btn-num" data-valu=
e=3D"3">3</button>
                    <button type=3D"button" class=3D"btn btn-op" data-value=
=3D"+">+</button>
                    <button type=3D"button" class=3D"btn btn-eq btn-tall" d=
ata-action=3D"equals">=3D</button>

                    <button type=3D"button" class=3D"btn btn-num btn-zero" =
data-value=3D"0">0</button>
                    <button type=3D"button" class=3D"btn btn-num" data-valu=
e=3D".">.</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
