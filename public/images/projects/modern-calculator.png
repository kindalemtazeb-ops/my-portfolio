           =20

            <!-- TAB 1: SCIENTIFIC CALCULATOR -->
            <div class=3D"tab-panel active" id=3D"tab-sci">
                <div class=3D"display-box">
                    <div class=3D"expression" id=3D"expression"></div>
                    <div class=3D"display" id=3D"display">0</div>
                </div>

                <div class=3D"mem-row">
                    <button type=3D"button" class=3D"btn btn-mem" data-mem=
=3D"MC" title=3D"Memory Clear">MC</button>
                    <button type=3D"button" class=3D"btn btn-mem" data-mem=
=3D"MR" title=3D"Memory Recall">MR</button>
                    <button type=3D"button" class=3D"btn btn-mem" data-mem=
=3D"M+" title=3D"Memory Add">M+</button>
                    <button type=3D"button" class=3D"btn btn-mem" data-mem=
=3D"M-" title=3D"Memory Subtract">M-</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"rand" title=3D"Random Number (0-1)">Rand</button>
                </div>

                <div class=3D"sci-grid">
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"sqrt" title=3D"Square Root">=E2=88=9Ax</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"cbrt" title=3D"Cube Root">=E2=88=9Bx</button>
                    <button type=3D"button" class=3D"btn btn-value" data-va=
lue=3D"yroot(" title=3D"Y-th Root">=CA=B8=E2=88=9Ax</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
=3D"square" title=3D"Square">x=C2=B2</button>
                    <button type=3D"button" class=3D"btn btn-sci" data-fn=
