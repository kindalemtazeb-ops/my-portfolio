=3D"abs" title=3D"Absolute Value">|x|</button>
                    <button type=3D"button" class=3D"btn btn-const" data-co=
nst=3D"PI" title=3D"Pi">=CF=80</button>
                    <button type=3D"button" class=3D"btn btn-const" data-co=
nst=3D"E" title=3D"Euler's Number">e</button>
                </div>

                <div class=3D"buttons">
                    <button type=3D"button" class=3D"btn btn-fn" data-actio=
n=3D"clear">C</button>
                    <button type=3D"button" class=3D"btn btn-fn" data-actio=
n=3D"backspace">=E2=8C=AB</button>
                    <button type=3D"button" class=3D"btn btn-fn" data-fn=3D=
"sign">=C2=B1</button>
